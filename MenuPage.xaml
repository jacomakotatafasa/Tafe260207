<Page
    x:Class="Calculator.MenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid Background="White">

		<StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
			<Image
            Source="Assets/abacus.jpg"
            Width="150"
            Height="150"
            HorizontalAlignment="Center"
            Margin="0,0,0,20"/>

			<TextBlock
                Text="Universal Calculator"
                FontSize="32"
                FontWeight="Bold"
                HorizontalAlignment="left"
                Margin="0,0,0,20"/>

			<Button
                Content="Math Calculator"
                Width="250"
                Height="50"
                Margin="0,5"/>

			<Button
                Content="Mortgage Calculator"
                Width="250"
                Height="50"
                Margin="0,5"/>

			<Button
                Content="Currency Calculator"
                Width="250"
                Height="50"
                Margin="0,5"/>

			<Button
                Content="Exit"
                Width="250"
                Height="50"
                Margin="0,5"/>

		</StackPanel>

	</Grid>
</Page>